{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-msvc-ninja",
      "displayName": "Windows MSVC + Ninja (Release)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MS3D_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "linux-ninja",
      "displayName": "Linux Ninja (Release)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MS3D_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-msvc-ninja", "configurePreset": "windows-msvc-ninja" },
    { "name": "linux-ninja", "configurePreset": "linux-ninja" }
  ]
}
